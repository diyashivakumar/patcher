# Copy to .env (repo root) and fill in. Never commit .env.

# Neon PostgreSQL connection string (Neon console -> Connection Details). Must be PostgreSQL.
# Example shape: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional local AI (Ollama). PatchProof works fully without it. Team model: gemma4:e2b (ollama pull gemma4:e2b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Frontend origin allowed by CORS (comma-separate several)
FRONTEND_ORIGIN=http://localhost:5173

# Optional overrides (defaults shown)
# STORAGE_DIR=backend/storage
# TESTING_PYTHON=            # interpreter for python -m testing.runner (default: the backend's own)
# VERIFICATION_TIMEOUT_SECONDS=120
# MAX_UPLOAD_MB=10
