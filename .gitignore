# Secrets -- never commit
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
venv/
.venv/
.venv-*/
.pytest_cache/

# Backend runtime storage (uploaded projects, patched copies, backups)
backend/storage/

# Fixture scratch DBs (the harness always uses throwaway temp DBs)
fixtures/**/*.sqlite3
fixtures/**/*.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript incremental build cache (regenerated by every build)
*.tsbuildinfo
